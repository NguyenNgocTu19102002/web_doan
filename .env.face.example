# Server configuration template. Copy outside the public web root and Git.
# PHP does not load this file automatically: configure these variables in hosting/PHP.
FACE_ENABLED=1
FACE_SERVICE_URL=https://face-api.saviolaptri.com

# Use the same API key in PHP and the Python service environment.
FACE_SERVICE_KEY=REPLACE_WITH_API_KEY_AT_LEAST_32_CHARACTERS

# PHP only. Keep fixed and back up securely to decrypt existing templates.
FACE_TEMPLATE_KEY=REPLACE_WITH_SEPARATE_ENCRYPTION_KEY_AT_LEAST_32_CHARACTERS
